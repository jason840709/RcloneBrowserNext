{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rclone Browser Next",
  "version": "0.9.6",
  "identifier": "org.rclone.browser.next",
  "build": {
    "frontendDist": "../../.build-cache/compat/web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "Utility",
    "shortDescription": "Browse and transfer between local folders, NAS and clouds",
    "longDescription": "A dual-pane graphical rclone client. Supports copy, one-way sync, move, dry runs, saved tasks, transfer reports and six colour themes.",
    "copyright": "Copyright Jason Chen and contributors",
    "license": "MIT",
    "homepage": "https://github.com/jason840709/RcloneBrowserNext",
    "resources": {"../../.build-cache/compat/runtime/": "runtime/"},
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": false},
      "nsis": {"installMode": "currentUser", "displayLanguageSelector": true, "languages": ["English", "TradChinese", "Japanese"]}
    },
    "linux": {"deb": {"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libcurl4", "libxml2", "libsqlite3-0", "zlib1g", "libicu74", "xdg-utils", "xterm | gnome-terminal | konsole | xfce4-terminal"]}}
  }
}
